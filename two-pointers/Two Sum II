# Problem: Two Sum II - Input Array Is Sorted
# Pattern: Two Pointers (Opposite Direction)
# Approach: Start from both ends and move a pointer based on whether the current sum is greater or smaller than the target.
# Time Complexity: O(n)
# Space Complexity: O(1)
def twoSum(numbers,target):
    left=0
    right=len(numbers)-1
    while left<right:
        cur_sum=numbers[left]+numbers[right]
        if cur_sum>target:
            right-=1
        elif cur_sum<target:
            left+=1
        else:
            return [left+1,right+1]
